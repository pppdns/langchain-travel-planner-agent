{
  "name": "agent-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "supabase:gen-types:dev": "supabase gen types typescript --linked --schema public > supabase/database.types.ts && prettier --write supabase/database.types.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed:corpus": "tsx scripts/seed-corpus.ts",
    "test:ui": "vitest --ui",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --skipLibCheck --project tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/langchain": "^3.0.89",
    "@ai-sdk/react": "^4.0.92",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.11",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/functions": "^3.9.5",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.89",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.9.0"
}
