{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=mrwnejqdzcyukhkipcbe"
    },
    "Playwright": {
      "command": "npx -y @playwright/mcp@latest",
